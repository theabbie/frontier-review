{
  "name": "frontier-review",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic code-quality assessment: evidence-backed repository review with a fair baseline comparison.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --loader ts-node/esm tests/*.test.ts",
    "review": "node dist/cli/review.js",
    "eval": "node dist/cli/eval.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
